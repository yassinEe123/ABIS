FROM python:3.11-slim

WORKDIR /app

COPY dashboard/api/main.py .
COPY blockchain/ /blockchain/
COPY ai/ /ai/

RUN pip install --no-cache-dir \
    fastapi==0.118.0 \
    uvicorn[standard] \
    web3 \
    slowapi \
    sse-starlette

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
