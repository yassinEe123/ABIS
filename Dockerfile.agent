FROM python:3.11-slim

WORKDIR /app

COPY ai/requirements.txt* ./

RUN pip install --no-cache-dir \
    web3 \
    numpy \
    pandas \
    scikit-learn \
    joblib \
    requests

COPY ai/ /app/ai/
COPY blockchain/ /app/blockchain/

ENV ABIS_RPC=http://blockchain:8545

CMD ["python3", "/app/ai/agent/abis_agent.py"]
